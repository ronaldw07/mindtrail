GROQ_API_KEY=
# Optional backups, used in this order once Groq's free daily limit is
# reached: https://cloud.cerebras.ai and https://aistudio.google.com/apikey
CEREBRAS_API_KEY=
GEMINI_API_KEY=
# Optional fallback search provider
TAVILY_API_KEY=
# Required to run `mindtrail chat --host 0.0.0.0` (or any non-loopback
# host) - the server refuses to start without it. Not needed for the
# default 127.0.0.1 bind.
MINDTRAIL_TOKEN=
